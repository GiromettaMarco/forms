{
  "name": "@gmcode/tsv-rhf",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "author": "Girometta Marco",
  "description": "Custom React Hook Form resolver for Typescript Validation Schema.",
  "homepage": "https://github.com/GiromettaMarco/forms#readme",
  "bugs": {
    "url": "https://github.com/GiromettaMarco/forms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiromettaMarco/forms.git"
  },
  "keywords": [
    "i18n",
    "react-hook-form",
    "schema",
    "typescript",
    "validation"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "vite build",
    "preinstall": "npx only-allow pnpm",
    "types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react-hook-form": "^7.71.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.1",
    "unplugin-dts": "^1.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.14"
  }
}
