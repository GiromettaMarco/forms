{
  "name": "@gmcode/tsv-input",
  "version": "0.0.7",
  "type": "module",
  "license": "MIT",
  "author": "Girometta Marco",
  "description": "Form input schema validations with i18n support.",
  "homepage": "https://github.com/GiromettaMarco/forms#readme",
  "bugs": {
    "url": "https://github.com/GiromettaMarco/forms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiromettaMarco/forms.git"
  },
  "keywords": [
    "forms",
    "i18n",
    "input",
    "schema",
    "validation"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run --coverage",
    "test:badge": "node node_modules/@repo/vite-config/dist/scripts/badge.js"
  },
  "dependencies": {
    "@gmcode/tsv-core": "^0.0.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vite-config": "workspace:*",
    "@microsoft/api-extractor": "^7.58.1",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.1",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
