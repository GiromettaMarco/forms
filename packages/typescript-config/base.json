{
  "$schema": "https://json.schemastore.org/tsconfig",

  "compilerOptions": {
    // Output
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "inlineSources": false,
    "isolatedModules": true,
    "sourceMap": true,

    // Constraints
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": true,

    // Performance
    "skipLibCheck": true
  },
  "exclude": ["node_modules"]
}
