{
  "semi": false,
  "singleQuote": true,
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "css",
  "plugins": [
    "prettier-plugin-organize-imports",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindFunctions": ["clsx", "cn", "cva"],
  "tailwindStylesheet": "./app/global.css",
  "tabWidth": 2,
  "trailingComma": "none"
}
