{
  "name": "@gmcode/react-ui",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "author": "Girometta Marco",
  "description": "General purpose React UI based on shadcn components.",
  "homepage": "https://github.com/GiromettaMarco/forms#readme",
  "bugs": {
    "url": "https://github.com/GiromettaMarco/forms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiromettaMarco/forms.git"
  },
  "keywords": [
    "radix-ui",
    "react",
    "shadcn",
    "tailwind",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/index.d.ts"
    }
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preinstall": "npx only-allow pnpm",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run --project=storybook --coverage",
    "test:badge": "node node_modules/@repo/vite-config/dist/scripts/badge.js"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "playwright": "^1.60.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-textarea-autosize": "^8.5.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vite-config": "workspace:*",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-themes": "^10.4.4",
    "@storybook/addon-vitest": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-istanbul": "^4.1.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.4.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.1",
    "vite": "^8.0.14",
    "vitest": "^4.1.8"
  }
}
