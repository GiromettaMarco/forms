{
  "name": "@gmcode/tsv-hookform",
  "version": "0.0.6",
  "type": "module",
  "license": "MIT",
  "author": "Girometta Marco",
  "description": "Custom react-hook-form resolver for @gmcode/tsv-input.",
  "homepage": "https://github.com/GiromettaMarco/forms#readme",
  "bugs": {
    "url": "https://github.com/GiromettaMarco/forms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiromettaMarco/forms.git"
  },
  "keywords": [
    "i18n",
    "react-hook-form",
    "schema",
    "typescript",
    "validation"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run --coverage",
    "test:badge": "node node_modules/@repo/vite-config/dist/scripts/badge.js"
  },
  "peerDependencies": {
    "@gmcode/tsv-core": "^0.0.6",
    "react-hook-form": "^7.71.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vite-config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.1",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0"
  }
}
