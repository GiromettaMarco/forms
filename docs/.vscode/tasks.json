  "version": "2.0.0",
  "tasks": [
    {
      "label": "$(trash) clear",
      "detail": "Remove node modules and artifacts dirs. Requires rimraf installed globally.",
      "type": "shell",
      "command": "rimraf -g -- **/node_modules **/coverage **/dist **/storybook-static **/__screenshots__ **/.vitest-attachments",
      "options": {
        "statusbar": {
          "label": "$(trash)",
          "detail": "clear",
          "color": "#22C1D6"
        }
      }
    }
  ]
}
